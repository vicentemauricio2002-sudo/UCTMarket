ScreenManager:

    LoginScreen:
        name: "login"

    PrincipalScreen:
        name: "principal"

    PerfilScreen:
        name: "perfil"


<LoginScreen>:
    md_bg_color: app.theme_cls.backgroundColor
    MDBoxLayout:
        orientation: "vertical"
        padding: "50dp"
        spacing: "20dp"
        theme_text_color: "Primary"

        Widget:
            size_hint_y: 0.25

        MDLabel:
            text: "Marketplace UCT"
            halign: "center"
            font_style: "Headline"
            theme_text_color: "Primary"
            size_hint_y: None
            height: "60dp"
        
        MDScrollView: 
            MDBoxLayout:
                orientation: "vertical"
                spacing: "15dp"
                adaptive_height: True

                MDLabel:
                    text: "Compra, vende e intercambia dentro de la comunidad universitaria"
                    halign: "center"
                    theme_text_color: "Secondary"
                    size_hint_y: None
                    height: "60dp"

                MDTextField:
                    id: nombre
                    mode: "outlined"
                    size_hint_x: 0.9
                    pos_hint: {"center_x": 0.5}

                    MDTextFieldHintText:
                        text: "Ingresa tu nombre"

                Widget:
                    size_hint_y: 0.05

                MDButton:
                    style: "tonal"
                    pos_hint: {"center_x": 0.5}
                    size_hint_x: 0.7
                    on_release: root.ingresar()

                    MDButtonText:
                        text: "Ingresar"

                Widget:
                    size_hint_y: 0.3


<PrincipalScreen>:
    md_bg_color: app.theme_cls.backgroundColor
    MDBoxLayout:
        orientation: "vertical"
        theme_text_color: "Primary"

        MDTopAppBar:
            type: "small" 
            size_hint_y: None
            theme_bg_color: "Custom"
            md_bg_color: app.theme_cls.secondaryContainerColor
            height: "84dp"
            MDTopAppBarTitle:
                text: "Marketplace UCT"
        MDScrollView:
            MDBoxLayout:
                orientation: "vertical"
                spacing: "15dp"
                padding: "50dp"
                adaptive_height: True

                MDLabel:
                    id: bienvenida
                    text: "Bienvenido"
                    font_style: "Title"
                    theme_text_color: "Primary"
                    size_hint_y: None
                    height: "40dp"

                MDTextField:
                    mode: "outlined"
                    size_hint_x: 0.9
                    pos_hint: {"center_x": 0.5}

                    MDTextFieldLeadingIcon:
                        icon: "magnify"

                    MDTextFieldHintText:
                        text: "Buscar productos..."

                MDLabel:
                    text: "Publicaciones recientes"
                    font_style: "Title"
                    theme_text_color: "Primary"
                    size_hint_y: None
                    height: "50dp"

                MDCard:
                    style: "elevated"
                    orientation: "vertical"
                    padding: "15dp"
                    spacing: "5dp"
                    size_hint_y: None
                    height: "150dp"

                    MDLabel:
                        text: "iPhone 12"
                        font_style: "Title"

                    MDLabel:
                        text: "$250.000"

                    MDLabel:
                        text: "Publicado por estudiante UCT"

                MDCard:
                    style: "elevated"
                    orientation: "vertical"
                    padding: "15dp"
                    spacing: "5dp"
                    size_hint_y: None
                    height: "150dp"

                    MDLabel:
                        text: "Libros de cálculo"
                        font_style: "Title"

                    MDLabel:
                        text: "$15.000"

                    MDLabel:
                        text: "Publicado por estudiante UCT"

                Widget:

                MDButton:
                    style: "tonal"
                    theme_text_color: "Primary"
                    pos_hint: {"center_x": 0.5}
                    on_release: root.manager.current = "perfil"

                    MDButtonText:
                        text: "Ver perfil"


<PerfilScreen>:
    md_bg_color: app.theme_cls.backgroundColor
    MDBoxLayout:
        orientation: "vertical"
        theme_text_color: "Primary"

        MDTopAppBar:
            type: "small" 
            size_hint_y: None
            height: "84dp"
            MDTopAppBarTitle:
                text: "Marketplace UCT"

        MDScrollView:
            MDBoxLayout:
                orientation: "vertical"
                spacing: "15dp"
                padding: "50dp"
                adaptive_height: True
                Widget:
                    size_hint_y: 0.1

                MDLabel:
                    text: "👤"
                    halign: "center"
                    font_size: "50sp"
                    size_hint_y: None
                    height: "80dp"

                MDLabel:
                    id: nombre_perfil
                    text: "Usuario"
                    halign: "center"
                    font_style: "Headline"
                    theme_text_color: "Primary"
                    size_hint_y: None
                    height: "60dp"

                MDLabel:
                    text: "Mis publicaciones"
                    halign: "center"
                    font_style: "Title"
                    size_hint_y: None
                    height: "50dp"

                MDButton:
                    style: "outlined"
                    pos_hint: {"center_x": 0.5}

                    MDButtonText:
                        text: "Mis publicaciones"

                Widget:

                MDButton:
                    style: "tonal"
                    pos_hint: {"center_x": 0.5}
                    on_release: root.manager.current = "principal"

                    MDButtonText:
                        text: "Volver al Marketplace"

                Widget:
                    size_hint_y: 0.1
