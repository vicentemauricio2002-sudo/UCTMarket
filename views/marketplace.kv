#:import dp kivy.metrics.dp
#:import FadeTransition kivy.uix.screenmanager.FadeTransition

MDBoxLayout:
    id: root_layout
    orientation: "vertical"

    MDTopAppBar:
        id: topbar
        type: "small"
        theme_bg_color: "Custom"
        md_bg_color: app.PALETA["azul_brillante"]
        padding: dp(12)

        MDTopAppBarTitle:
            text: "UCTMarket"
            theme_text_color: "Custom"
            text_color: app.PALETA["blanco"]

        MDTopAppBarTrailingButtonContainer:
            id: botones_topbar
            MDActionTopAppBarButton:
                icon: "home-outline"
                theme_icon_color: "Custom"
                icon_color: app.PALETA["blanco"]
                on_release: app.ir_a_pantalla("principal")

            MDActionTopAppBarButton:
                icon: "store-outline"
                theme_icon_color: "Custom"
                icon_color: app.PALETA["blanco"]
                on_release: app.ir_a_pantalla("market")

            MDActionTopAppBarButton:
                icon: "account-outline"
                theme_icon_color: "Custom"
                icon_color: app.PALETA["blanco"]
                on_release: app.ir_a_pantalla("perfil")
            
            Widget:
                size_hint_x: None
                width: "20dp"

            MDButton:
                style: "filled"
                theme_bg_color: "Custom"
                md_bg_color: app.PALETA["blanco"]
                pos_hint: {"center_x": 0.5}
                on_release: app.ir_a_pantalla("login")

                MDButtonText:
                    text: "Cerrar sesión"
                    theme_text_color: "Custom"
                    text_color: app.PALETA["primario"]

    ScreenManager:
        id: screen_manager
        transition: FadeTransition(duration=0.18)

        LoginScreen:
            name: "login"

        RegistroScreen:
            name: "registro"

        PrincipalScreen:
            name: "principal"
        
        MarketScreen:
            name: "market"
        
        ProductoScreen:
            name: "producto"

        PerfilScreen:
            name: "perfil"

<LoginScreen>:
    BoxLayout:
        orientation: "vertical"

        canvas.before:
            Color:
                rgba: app.PALETA["fondo"]
            Rectangle:
                pos: self.pos
                size: self.size

        ScrollView:
            do_scroll_x: False
            do_scroll_y: True
            bar_width: dp(4)
        
            AnchorLayout:
                anchor_x: "center"
                anchor_y: "center"
                padding: dp(60), 0, dp(60), 0

                MDBoxLayout:
                    orientation: "vertical"
                    size_hint_y: None
                    height: self.minimum_height
                    padding: [dp(8), dp(16), dp(8), dp(16)]
                    spacing: dp(12)

                    MDLabel:
                        text: "Iniciar sesión"
                        font_style: "Headline"
                        role: "medium"
                        halign: "center"
                        theme_text_color: "Custom"
                        text_color: app.PALETA["azul_noche"]
                        size_hint_y: None
                        height: dp(48)

                    MDTextField:
                        id: nombre
                        mode: "outlined"
                        multiline: False
                        size_hint_y: None
                        height: dp(56)
                        on_focus: root.limpiar_mensaje() if self.focus else None
                        MDTextFieldHintText:
                            text: "Nombre de usuario"

                    MDTextField:
                        id: contrasena
                        mode: "outlined"
                        password: True
                        size_hint_y: None
                        height: dp(56)
                        on_focus: root.limpiar_mensaje() if self.focus else None
                        MDTextFieldHintText:
                            text: "Contraseña"

                    MDLabel:
                        id: mensaje
                        text: ""
                        font_style: "Body"
                        role: "small"
                        halign: "center"
                        theme_text_color: "Custom"
                        text_color: app.PALETA["azul_intenso"]
                        size_hint_y: None
                        height: self.texture_size[1] if self.text else 0
                        text_size: self.width, None

                    MDButton:
                        style: "filled"
                        theme_bg_color: "Custom"
                        md_bg_color: app.PALETA["primario"]
                        pos_hint: {"center_x": 0.5}
                        on_release: root.ingresar()

                        MDButtonText:
                            text: "Ingresar"
                            theme_text_color: "Custom"
                            text_color: app.PALETA["blanco"]

                    MDButton:
                        style: "text"
                        pos_hint: {"center_x": 0.5}
                        on_release: app.root.ids.screen_manager.current = "registro"
                        MDButtonIcon:
                            icon: "arrow-left"
                            theme_text_color: "Custom"
                            text_color: app.PALETA["primario"]

                        MDButtonText:
                            text: "Crear cuenta"
                            theme_text_color: "Custom"
                            text_color: app.PALETA["azul_noche"]


<RegistroScreen>:
    BoxLayout:
        orientation: "vertical"

        canvas.before:
            Color:
                rgba: app.PALETA["fondo"]
            Rectangle:
                pos: self.pos
                size: self.size

        ScrollView:
            do_scroll_x: False
            do_scroll_y: True
            bar_width: dp(4)
        
            AnchorLayout:
                anchor_x: "center"
                anchor_y: "center"
                padding: dp(60), 0, dp(60), 0

                MDBoxLayout:
                    orientation: "vertical"
                    size_hint_y: None
                    height: self.minimum_height
                    padding: [dp(8), dp(16), dp(8), dp(16)]
                    spacing: dp(12)

                    MDLabel:
                        text: "Crea tu cuenta"
                        font_style: "Headline"
                        role: "medium"
                        halign: "center"
                        theme_text_color: "Custom"
                        text_color: app.PALETA["azul_noche"]
                        size_hint_y: None
                        height: dp(48)

                    MDTextField:
                        id: nombre
                        mode: "outlined"
                        multiline: False
                        size_hint_y: None
                        height: dp(56)
                        on_focus: root.limpiar_mensaje() if self.focus else None
                        MDTextFieldHintText:
                            text: "Nombre de usuario"

                    MDTextField:
                        id: contrasena
                        mode: "outlined"
                        password: True
                        size_hint_y: None
                        height: dp(56)
                        on_focus: root.limpiar_mensaje() if self.focus else None
                        MDTextFieldHintText:
                            text: "Contraseña"

                    MDLabel:
                        id: mensaje
                        text: ""
                        font_style: "Body"
                        role: "small"
                        halign: "center"
                        theme_text_color: "Custom"
                        text_color: app.PALETA["azul_intenso"]
                        size_hint_y: None
                        height: self.texture_size[1] if self.text else 0
                        text_size: self.width, None

                    MDButton:
                        style: "filled"
                        theme_bg_color: "Custom"
                        md_bg_color: app.PALETA["primario"]
                        pos_hint: {"center_x": 0.5}
                        on_release: root.registrarse()

                        MDButtonText:
                            text: "Registrar"
                            theme_text_color: "Custom"
                            text_color: app.PALETA["blanco"]

                    MDButton:
                        style: "text"
                        pos_hint: {"center_x": 0.5}
                        on_release: app.root.ids.screen_manager.current = "login"
                        MDButtonIcon:
                            icon: "arrow-left"
                            theme_text_color: "Custom"
                            text_color: app.PALETA["primario"]

                        MDButtonText:
                            text: "Iniciar sesión"
                            theme_text_color: "Custom"
                            text_color: app.PALETA["azul_noche"]



<PrincipalScreen>:
    BoxLayout:
        orientation: "vertical"

        canvas.before:
            Color:
                rgba: app.PALETA["fondo"]
            Rectangle:
                pos: self.pos
                size: self.size

        ScrollView:
            do_scroll_x: False
            do_scroll_y: True
            bar_width: dp(5)

            MDBoxLayout:
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                padding: [dp(60), dp(60), dp(60), dp(40)]
                spacing: dp(32)

               
                MDBoxLayout:
                    orientation: "vertical"
                    adaptive_height: True
                    spacing: dp(4)

                    MDLabel:
                        id: usuario_label
                        text: "Bienvenido a UCTMarket"
                        font_style: "Headline"
                        role: "medium"
                        theme_text_color: "Custom"
                        text_color: app.PALETA["azul_noche"]
                        adaptive_height: True

                    MDLabel:
                        text: "Un marketplace para la comunidad de la UCT"
                        font_style: "Body"
                        role: "medium"
                        theme_text_color: "Custom"
                        text_color: app.PALETA["azul_noche"]
                        adaptive_height: True
      
                MDBoxLayout:
                    orientation: "vertical"
                    adaptive_height: True
                    spacing: dp(10)

                    MDCard:
                        style: "elevated"
                        orientation: "vertical"
                        theme_bg_color: "Custom"
                        md_bg_color: app.PALETA["blanco"]
                        padding: dp(18)
                        spacing: dp(8)
                        size_hint_y: None
                        height: max(dp(80), self.minimum_height)
                        radius: [dp(20)]
                        elevation: 1

                        MDLabel:
                            text: "Lista de deseos"
                            font_style: "Title"
                            role: "large"
                            theme_text_color: "Custom"
                            text_color: app.PALETA["azul_noche"]
                            adaptive_height: True
                        
                        MDLabel:
                            text: "Los productos que has agregado a tu lista de deseos aparecerán aquí."
                            font_style: "Body"
                            role: "medium"
                            theme_text_color: "Custom"
                            text_color: app.PALETA["texto_secundario"]
                            adaptive_height: True

                        MDLabel:
                            id: listdeseos_label
                            text: ""
                            font_style: "Body"
                            role: "medium"
                            theme_text_color: "Custom"
                            text_color: app.PALETA["texto"]
                            size_hint_y: None
                            height: self.texture_size[1] + dp(8)
                            text_size: self.width, None
                        
                        MDGridLayout:
                            id: lista_de_deseos_productos
                            adaptive_height: True
                            spacing: dp(16)
                            cols: 2


<MarketScreen>:
    MDBoxLayout:
        orientation: "vertical"

        canvas.before:
            Color:
                rgba: app.PALETA["fondo"]
            Rectangle:
                pos: self.pos
                size: self.size

        ScrollView:
            do_scroll_x: False
            do_scroll_y: True
            bar_width: dp(5)

            MDBoxLayout:
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                padding: [dp(60), dp(60), dp(60), dp(40)]
                spacing: dp(32)

                MDTextField:
                    id: busqueda
                    mode: "outlined"
                    pos_hint: {"center_x": 0.5}
                    height: dp(56)
                    on_text: root.buscar_productos(self.text)
                    on_focus: root.registrar_busqueda(self.text, self.focus)

                    MDTextFieldHintText:
                        text: "Buscar productos..."
                        theme_text_color: "Custom"
                        text_color_normal: app.PALETA["texto_secundario"]

                    MDTextFieldLeadingIcon:
                        icon: "magnify"

                MDLabel:
                    text: "Publicaciones recientes"
                    font_style: "Title"
                    theme_text_color: "Custom"
                    text_color: app.PALETA["azul_noche"]
                    size_hint_y: None
                    height: dp(50)

                MDGridLayout:
                    id: lista_productos
                    adaptive_height: True
                    spacing: dp(16)
                    cols: 2


<ProductoScreen>:
    BoxLayout:
        orientation: "vertical"

        canvas.before:
            Color:
                rgba: app.PALETA["fondo"]
            Rectangle:
                pos: self.pos
                size: self.size

        ScrollView:
            do_scroll_x: False
            do_scroll_y: True
            bar_width: dp(5)

            MDBoxLayout:
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                padding: [dp(60), dp(60), dp(60), dp(40)]
                spacing: dp(32)

                MDButton:
                    style: "text"
                    on_release: root.volver()

                    MDButtonIcon:
                        icon: "arrow-left"
                        theme_text_color: "Custom"
                        text_color: app.PALETA["primario"]

                    MDButtonText:
                        text: "Volver"

                MDCard:
                    style: "elevated"
                    orientation: "vertical"
                    padding: dp(24)
                    spacing: dp(16)
                    size_hint_y: None
                    height: self.minimum_height
                    radius: [dp(20)]
                    elevation: 1
                    theme_bg_color: "Custom"
                    md_bg_color: app.PALETA["blanco"]

                    MDFloatLayout:
                        MDButton:
                            style: "text"
                            pos_hint: {"center_x": 1, "center_y": 0.5}
                            opacity: 1 if root.es_mi_publicacion else 0
                            disabled: not root.es_mi_publicacion
                            on_release: root.editar_publicacion()

                            MDButtonIcon:
                                pos_hint: {"center_x": 0.5, "center_y": 0.5}
                                icon: "pencil-outline"
                                theme_icon_color: "Custom"
                                icon_color: app.PALETA["primario"]

                    MDLabel:
                        id: nombre_producto
                        text: "Nombre del producto"
                        font_style: "Headline"
                        role: "large"
                        adaptive_height: True

                    MDCard:
                        style: "filled"
                        orientation: "vertical"
                        size_hint_y: None
                        height: dp(300)
                        radius: [dp(20)]
                        theme_bg_color: "Custom"
                        md_bg_color: app.PALETA["blanco"]
                        on_release: root.ver_imagen_completa()

                        FitImage:
                            id: imagen_producto
                            source: "imgs/img_productos/placeholder.png"

                    MDBoxLayout:
                        orientation: "horizontal"
                        adaptive_height: True
                        spacing: dp(4)

                        MDButton:
                            style: "filled"
                            theme_bg_color: "Custom"
                            md_bg_color: app.PALETA["primario"]
                            opacity: 0.4 if root.es_mi_publicacion else 1
                            disabled: root.es_mi_publicacion
                            on_release: root.comprar_producto()

                            MDButtonText:
                                text: "Comprar"
                                theme_text_color: "Custom"
                                text_color: app.PALETA["blanco"]

                        MDButton:
                            style: "text"
                            opacity: 0.4 if root.es_mi_publicacion else 1
                            disabled: root.es_mi_publicacion
                            on_release: root.alternar_lista_deseos()

                            MDButtonIcon:
                                icon: root.icono_deseos
                                theme_icon_color: "Custom"
                                icon_color: app.PALETA["primario"]
                                pos_hint: {"center_x": 0.5, "center_y": 0.5}
                    

                    MDLabel:
                        text: "Precio:"
                        font_style: "Body"
                        role: "medium"
                        theme_text_color: "Custom"
                        text_color: app.PALETA["texto_secundario"]
                        adaptive_height: True

                    MDLabel:
                        id: precio_producto
                        text: "Precio"
                        font_style: "Title"
                        role: "large"
                        adaptive_height: True

                    MDLabel:
                        text: "Descripción:"
                        font_style: "Body"
                        role: "medium"
                        theme_text_color: "Custom"
                        text_color: app.PALETA["texto_secundario"]
                        adaptive_height: True
                    MDLabel:
                        id: descripcion_producto
                        text: "Descripción"
                        adaptive_height: True

                    MDLabel:
                        text: "Vendedor:"
                        font_style: "Body"
                        role: "medium"
                        theme_text_color: "Custom"
                        text_color: app.PALETA["texto_secundario"]
                        adaptive_height: True
                    MDLabel:
                        id: vendedor_producto
                        text: "Vendedor"
                        adaptive_height: True


<PerfilScreen>:
    BoxLayout:
        orientation: "vertical"

        canvas.before:
            Color:
                rgba: app.PALETA["fondo"]
            Rectangle:
                pos: self.pos
                size: self.size

        ScrollView:
            do_scroll_x: False
            do_scroll_y: True
            bar_width: dp(5)

            MDBoxLayout:
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                padding: [dp(60), dp(60), dp(60), dp(40)]
                spacing: dp(32)

                MDCard:
                    style: "elevated"
                    orientation: "vertical"
                    padding: dp(24)
                    spacing: dp(8)
                    size_hint_y: None
                    height: self.minimum_height
                    radius: [dp(20)]
                    elevation: 1
                    theme_bg_color: "Custom"
                    md_bg_color: app.PALETA["blanco"]

                    MDFloatLayout:
                        MDButton:
                            style: "text"
                            pos_hint: {"center_x": 1, "center_y": 0.5}
                            #on_release: root.abrir_configuracion()

                            MDButtonIcon:
                                pos_hint: {"center_x": 0.5, "center_y": 0.5}
                                icon: "cog-outline"
                                theme_icon_color: "Custom"
                                icon_color: app.PALETA["primario"]

                    AnchorLayout:
                        anchor_x: "center"
                        size_hint_y: None
                        height: dp(100)

                        FitImage:
                            id: usuario_foto
                            source: "imgs/img_perfiles/placeholder.png"
                            size_hint: None, None
                            size: dp(100), dp(100)
                            radius: [dp(50)]

                    MDLabel:
                        id: usuario_nombre_label
                        text: "Usuario"
                        font_style: "Headline"
                        role: "small"
                        halign: "center"
                        theme_text_color: "Custom"
                        text_color: app.PALETA["azul_noche"]
                        adaptive_height: True

                    MDLabel:
                        text: "Tu perfil"
                        font_style: "Body"
                        role: "medium"
                        halign: "center"
                        theme_text_color: "Custom"
                        text_color: app.PALETA["texto_secundario"]
                        adaptive_height: True
            
                MDCard:
                    style: "elevated"
                    orientation: "vertical"
                    padding: dp(24)
                    spacing: dp(8)
                    size_hint_y: None
                    height: max(dp(80), self.minimum_height)
                    radius: [dp(20)]
                    elevation: 1
                    theme_bg_color: "Custom"
                    md_bg_color: app.PALETA["blanco"]

                    MDFloatLayout:
                        MDButton:
                            style: "text"
                            pos_hint: {"center_x": 1, "center_y": 0.5}
                            on_release: root.crear_publicacion()

                            MDButtonIcon:
                                pos_hint: {"center_x": 0.5, "center_y": 0.5}
                                icon: "plus"
                                theme_icon_color: "Custom"
                                icon_color: app.PALETA["primario"]

                    MDLabel:
                        text: "Mis Publicaciones"
                        font_style: "Title"
                        role: "large"
                        theme_text_color: "Custom"
                        text_color: app.PALETA["azul_noche"]
                        adaptive_height: True

                    MDGridLayout:
                        id: lista_perfil_productos
                        adaptive_height: True
                        spacing: dp(16)
                        cols: 2